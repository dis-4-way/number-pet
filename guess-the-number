import random

# 1. Загадываем число от 1 до 100
secret = random.randint(1, 100)

print("Я загадал число от 1 до 100. Попробуй угадать!")

# 2. Бесконечный цикл (выход только при угадывании)
while True:
    # 3. Получаем догадку от игрока
    guess = int(input("Твоё число: "))
    
    # 4. Сравниваем и даём подсказку
    if guess < secret:
        print("Больше!")
    elif guess > secret:
        print("Меньше!")
    else:
        print("Поздравляю! Ты угадал!")
        break  # выход из цикла